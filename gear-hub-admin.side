          "target": "css=button[type=\"submit\"]",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-004",
          "comment": "Provera banera greške na loginu",
          "command": "waitForElementVisible",
          "target": "css=.alert-error",
          "targets": [],
          "value": "5000"
        },
        {
          "id": "cmd-005",
          "comment": "Unos ispravnog admin korisničkog imena (zaobilazi Firefox initKeyEvent bag u Selenium IDE)",
          "command": "executeScript",
          "target": "const el = document.getElementById('login-username'); el.value = 'admin'; el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true }));",
