      "commands": [
        {
          "id": "cmd-001",
          "comment": "Otvaranje login stranice",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-002",
          "comment": "Podešavanje veličine prozora",
          "command": "setWindowSize",
          "target": "1440x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-003",
          "comment": "Test prazne forme za prijavu (očekuje se greška)",
